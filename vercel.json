{
    "services": {
        "frontend": {
            "root": "frontend",
            "framework": "vite"
        },
        "backend": {
            "root": "backend",
            "entrypoint": "api/index.js"
        }
    },
    "rewrites": [
        {
            "source": "/lot-de-films",
            "destination": {
                "service": "backend"
            }
        },
        {
            "handle": "filesystem"
        },
        {
            "source": "/(.*)",
            "destination": {
                "service": "frontend",
                "path": "index.html"
            }
        }
    ]
}